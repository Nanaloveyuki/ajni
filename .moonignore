# Match repository build-output exclusions; publishing uses this instead of .gitignore.
ref/
tmp/
_build/
.moon/
.hvigor/
android/.gradle/
android/.kotlin/
android/local.properties
android/**/build/
android/**/.cxx/
android/.idea/
.idea/
*.iml
scripts/__pycache__/
tests/**/.mooncakes/
tests/**/_build/
tests/**/__pycache__/

# Harmony verification is a separate, unpublished SDK/Stage application.
tests/ohos/
scripts/build-ohos-mvp.py
scripts/run-ohos-mvp.py

# Preserve both toolchain pins alongside the published Android build scripts.
!/.moon-version
!/.moonbit-toolchain
!/.moonignore
