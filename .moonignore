# Match repository build-output exclusions; publishing uses this instead of .gitignore.
ref/
tmp/
_build/
.moon/
android/.gradle/
android/.kotlin/
android/local.properties
android/**/build/
android/**/.cxx/
android/.idea/
.idea/
*.iml
scripts/__pycache__/
tests/**/.mooncakes/
tests/**/_build/
tests/**/__pycache__/

# Published Android build scripts read this pin too.
!/.moon-version
