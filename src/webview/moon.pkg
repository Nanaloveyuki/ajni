import {
  "Nanaloveyuki/ajni",
  "Nanaloveyuki/ajni/android",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/quickcheck",
} for "wbtest"

// ajni_webview_bridge.c uses android's native lease/error symbols, not managed APIs.

warnings = "-unused_package"

options(
  "native-stub": [ "ajni_webview_bridge.c" ],
  link: {
    "native": {
      "exports": [ "dispatch_from_android:ajni_dispatch_webview_event" ],
    },
  },
  targets: { "ffi.mbt": [ "native" ] },
)
