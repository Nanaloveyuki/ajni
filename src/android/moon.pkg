import {
  "Nanaloveyuki/ajni",
  "Nanaloveyuki/ajni/runtime",
}

import {
  "moonbitlang/core/quickcheck",
} for "test"

// ajni_bridge.c uses runtime's native stub; no managed API reference is needed.

warnings = "-unused_package"

options(
  "native-stub": [ "ajni_bridge.c" ],
  link: {
    "native": { "exports": [ "dispatch_from_android:ajni_dispatch_event" ] },
  },
  targets: { "ffi.mbt": [ "native" ] },
)
